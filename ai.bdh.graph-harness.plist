<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.bdh.graph-harness</string>

    <!-- start-server.sh resolves the provider credential (OLLAMA_API_KEY,
         OPENROUTER_API_KEY or OPENCODE_ZEN_API_KEY) from .env / ~/.hermes/.env
         before exec'ing the server, so launchd itself carries no secrets. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/albi/Projects/bdh-graph-harness/start-server.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/albi/Projects/bdh-graph-harness</string>

    <!-- HERMES_HOME lets config.py resolve the Nous fallback key from
         ~/.hermes/auth.json instead of requiring it in the environment.
         PATH includes the project venv first so the checked-out package and
         its dependencies are the ones actually used. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HERMES_HOME</key>
        <string>/Users/albi/.hermes</string>
        <key>PATH</key>
        <string>/Users/albi/Projects/bdh-graph-harness/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
        <string>Background</string>
    </array>

    <key>UserName</key>
    <string>albi</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- 30s minimum between respawns so a crash-loop cannot hammer launchd. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- aiohttp's run_app handles SIGTERM; give it room to drain before
         launchd escalates to SIGKILL. -->
    <key>ExitTimeOut</key>
    <integer>25</integer>

    <key>StandardOutPath</key>
    <string>/Users/albi/.hermes/logs/bdh-server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/albi/.hermes/logs/bdh-server.error.log</string>
</dict>
</plist>
